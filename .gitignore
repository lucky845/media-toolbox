# --- Rust ---
target/
**/target/
Cargo.lock.bak

# --- 前端 ---
node_modules/
dist/
.vite/
*.tsbuildinfo

# --- wasm 产物（CI 构建期生成，不进仓库）---
crates/wasm/pkg/
*.wasm
*.wasm.br
*.wasm.gz

# --- 桌面 sidecar 二进制（构建期拉取，不进仓库）---
src-tauri/sidecar/**/*
!src-tauri/sidecar/README.md
# release 用合并配置（CI 构建期生成）
src-tauri/tauri.release.conf.json

# --- 字体产物（构建期子集化生成）---
public/fonts/*.woff2
public/fonts/*.ttf
public/fonts/*.otf

# --- pdf.js 运行文件（构建期从 npm 依赖拷贝，不进仓库）---
public/pdfjs/

# --- GitHub Pages 自定义域 ---
# 用自定义 Actions 工作流部署时，GitHub 明确忽略仓库里的 CNAME 文件：
# "If you are publishing from a custom GitHub Actions workflow, no CNAME file is
#  created, and any existing CNAME file is ignored and is not required."
# 域名在仓库 Settings → Pages → Custom domain 里配置，DNS 在域名服务商配置。
# 因此本仓库不再需要 CNAME 文件（包括 dist/ 里 Vite 从 public/ 拷过去的副本）。
CNAME
**/CNAME

# --- 系统 / 编辑器 ---
.DS_Store
.idea/
.vscode/
*.log
.env
.env.local
